# BreedWise Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Places API (server-side only — never expose in client bundles)
# Live Google API calls are OFF by default. Set GOOGLE_PLACES_API_ENABLED=true to resume.
GOOGLE_PLACES_API_ENABLED=false
GOOGLE_PLACES_API_DISABLED=true
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# Do not use NEXT_PUBLIC_ for Google keys — maps use OpenStreetMap embeds instead.

# Resend webhook — outreach open/click tracking (Resend dashboard → Webhooks)
RESEND_WEBHOOK_SECRET=whsec_...
RESEND_FROM_EMAIL=info@breedwise.co.uk
RESEND_ADMIN_EMAIL=info@breedwise.co.uk

# Stripe (required for breeder subscriptions)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional fallbacks if stripe_tiers DB table has no price IDs yet:
# STRIPE_PRICE_BRONZE=price_...
# STRIPE_PRICE_SILVER=price_...
# STRIPE_PRICE_GOLD=price_...

# Application
NEXT_PUBLIC_SITE_URL=https://breedwise.co.uk
ADMIN_SETUP_SECRET=generate_a_strong_random_string_for_initial_admin_setup

# Cron — protect /api/cron/* routes (also add CRON_SECRET to GitHub repo secrets for Actions)
CRON_SECRET=generate_a_strong_random_string_for_cron_auth
# Weekly admin digest: .github/workflows/admin-weekly-digest.yml (Mondays 09:00 UTC)
# Search alerts: .github/workflows/search-alerts-cron.yml (daily 08:00 UTC)

# Disable first-time admin setup endpoint after initial admin exists
# ADMIN_SETUP_DISABLED=true

# Feature Flags
NEXT_PUBLIC_ADSENSE_ENABLED=false

# Whole-site offline — set SITE_OFFLINE=true to show maintenance page and block APIs
SITE_OFFLINE=false
# SITE_OFFLINE_MESSAGE=Custom message shown on the offline page
